# BE 환경변수 템플릿.
#
# 사용법: 이 파일을 BE/.env 로 복사한 뒤 값을 채우세요.
#   cp BE/.env.example BE/.env
#
# ⚠️ BE/.env 는 gitignore 대상입니다. 절대 커밋하지 마세요.
# ⚠️ 값을 application.yml 이나 소스 코드에 쓰지 마세요.
# ⚠️ 이 값들은 BE 에서만 씁니다. FE 로 내려보내지 않습니다.

# ── AI ──
# stub  : LLM 없이 동작 (기본값). 근거는 실제 DB 에서 오지만 문장은 템플릿입니다.
# openai: 실제 OpenAI 호출.
AI_PROVIDER=stub

# OpenAI API 키. AI_PROVIDER=openai 일 때만 필요합니다.
OPENAI_API_KEY=sk-...

# 모델. 예산을 고려해 mini 계열로 고정합니다.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ── 예산 가드레일 ──
# 하루 최대 LLM 호출 횟수. 초과하면 자동으로 스텁 응답으로 폴백합니다.
# 무한 루프나 실수로 예산이 새는 것을 막는 안전장치입니다.
OPENAI_DAILY_CALL_LIMIT=800

# 답변 1건당 최대 출력 토큰. 짧게 잡을수록 비용과 지연이 함께 줄어듭니다.
OPENAI_MAX_OUTPUT_TOKENS=400

# ── 인증 ──
# 간이 인증 토큰 서명 키. 로컬은 비워두면 기본값을 씁니다.
AUTH_SECRET=

# ── 공연 응모 완료 이메일 ──
# 아래 SMTP 값과 발신/수신 주소를 모두 채우면 자동으로 활성화됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
NOTIFICATION_SENDER_NAME=MBN 트롯 팬덤
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# ── 공연 응모 완료 문자(SOLAPI) ──
# SOLAPI 콘솔에서 API Key/Secret을 발급하고, SMS_FROM 번호를 먼저 등록해야 합니다.
# 아래 네 값을 모두 채우면 자동으로 활성화됩니다. 전화번호는 하이픈이 있어도 됩니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
NOTIFICATION_SMS_FROM=
NOTIFICATION_SMS_TO=
# Comma-separated browser origins allowed to call the backend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://mbn-mailgayo.netlify.app
